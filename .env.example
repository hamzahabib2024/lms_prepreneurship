# ---------------------------------------------------------------------------
# SRS-LMS-001 v2.1 — environment configuration
# Copy to .env and fill in. NEVER commit .env (SEC-CRY-008).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL 16 — mandated, §3.11) ----------------------------
# With Docker:  postgresql://lms:lms@localhost:5432/lms?schema=public
# Without Docker, use a free managed instance (e.g. Neon) and paste its URL.
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms?schema=public

# --- Redis 7 (cache, queue, rate limit, sequence locks) --------------------
# Optional in development: if unset the app falls back to in-memory (ARC-049).
REDIS_URL=redis://localhost:6379

# --- JWT (SEC-AUT-002..005: RS256, short access, rotating refresh) ---------
# Generate with:  npm run keys:generate
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=lms.local
JWT_AUDIENCE=lms-api

# --- Object storage (S3-compatible; Cloudflare R2 recommended, §3.11) ------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lms-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email (DEP-04) --------------------------------------------------------
# Leave MAIL_DRIVER=log in development: messages are written to the console
# instead of being sent.
MAIL_DRIVER=log
MAIL_FROM="LMS <no-reply@example.edu>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Google integration (DEP-01/DEP-02 — blocked until credentials issued) --
# Until these exist the storage provider runs in 'local' mode and video
# cataloguing is disabled. See OPN-02.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=

# --- Live classroom provider (LCAL, §3.4) ----------------------------------
# google_meet | manual | mock_classroom
LIVE_PROVIDER=manual

# --- Institute defaults (Appendix E — overridable in the settings UI) ------
INSTITUTE_CODE=CIIT
CAMPUS_CODE=ISB
DEFAULT_TIMEZONE=Asia/Karachi
