# ---------------------------------------------------------------------------
# SRS-LMS-001 v2.1 — environment configuration
# Copy to .env and fill in. NEVER commit .env (SEC-CRY-008).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL 16 — mandated, §3.11) ----------------------------
# For development you do not need Docker or a managed instance: `npm run
# db:start` runs a real PostgreSQL 16 from node_modules on this port, and this
# URL already points at it.
#
# The docker compose stack sets DATABASE_URL itself, from the POSTGRES_*
# values below — this line is ignored there.
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms?schema=public

# --- Redis (NOT USED) ------------------------------------------------------
# Nothing reads REDIS_URL. Playback tickets, which were the last thing that
# needed it, are rows in the database now (ARC-049), so a single-instance
# deployment needs no Redis at all and the compose stack does not run one.
#
# It becomes necessary to run MORE THAN ONE API instance: ActorService caches
# resolved roles per process for 15 minutes, and that cache has to be shared
# before a second node exists — see the note in docker-compose.yml.

# --- JWT (SEC-AUT-002..005: RS256, short access, rotating refresh) ---------
# Generate with:  npm run keys:generate
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=lms.local
JWT_AUDIENCE=lms-api

# --- Object storage (S3-compatible; Cloudflare R2 recommended, §3.11) ------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lms-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email (DEP-04) --------------------------------------------------------
# Leave MAIL_DRIVER=log in development: messages are written to the console
# instead of being sent.
# MAIL_DRIVER=log OVERRIDES everything below: nothing is sent even with valid
# credentials, and the wording goes to the simulator outbox instead. Keep it in
# development, where a database of real-looking students is one announcement
# away from being mailed by accident. Set it to smtp (or remove it) to send.
MAIL_DRIVER=log
MAIL_FROM="Prepreneurship <no-reply@example.edu>"

# Gmail: smtp.gmail.com / 587, and SMTP_PASSWORD is a 16-character App Password
# from the Google account, NOT the account's own password. See INTEGRATIONS.md.
# Port 465 is used as implicit TLS; 587 upgrades with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Used to turn a relative path such as /subjects into a link a recipient can
# click, and to build the sign-in address a new student is emailed.
#
# SET THIS IN ANY REAL DEPLOYMENT. Left empty the System falls back to
# WEB_ORIGIN, and if that is unset too, to http://localhost:5173 — which in an
# email means "the student's own computer" and works for nobody.
PUBLIC_WEB_URL=http://localhost:5173
INSTITUTE_NAME=Prepreneurship

# --- Google integration (DEP-01/DEP-02) ------------------------------------
# Until a key exists the storage provider runs in 'local' mode and video
# cataloguing is disabled. See OPN-02.
#
# TWO WAYS TO POINT AT THE KEY, and either is enough:
#
#   The PAIR below — the folder holding the key file and its filename. This is
#   what to use for an ordinary install, and it is the pair docker-compose
#   mounts at /run/credentials, so the same two lines work in both.
#
#   GOOGLE_SERVICE_ACCOUNT_JSON — a path to the key, OR the key's JSON pasted
#   in whole on one line, for a container platform that has environment
#   variables and no filesystem to mount. Set, it wins over the pair.
GOOGLE_CREDENTIALS_DIR=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long id in the folder's URL after /folders/. The folder must be shared
# with the service account's own address, which
#   node -r dotenv/config scripts/check-integrations.mjs
# prints for you.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=
# local | google_drive — where lecture video is read from.
LECTURE_STORAGE=local

# --- Live classroom provider (LCAL, §3.4) ----------------------------------
# google_meet | manual | mock_classroom
LIVE_PROVIDER=manual

# --- Institute defaults (Appendix E — overridable in the settings UI) ------
INSTITUTE_CODE=CIIT
CAMPUS_CODE=ISB
DEFAULT_TIMEZONE=Asia/Karachi

# ---------------------------------------------------------------------------
# Deployment only — read by docker-compose.yml, ignored in development.
# ---------------------------------------------------------------------------
POSTGRES_USER=lms
POSTGRES_DB=lms
# NO DEFAULT, on purpose. The compose file fails to start if this is unset
# rather than falling back to something guessable, because a database
# reachable with a published password is not protected by having a password.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# Signs the download URLs for stored files. Also has no default in the compose
# file: the code falls back to a string published in this repository, and
# anyone holding it can forge a URL for any payment slip or submission in the
# Institute. Generate it the same way as the password above.
LOCAL_STORAGE_SECRET=

# The port the Institute reaches the System on. Put a TLS terminator in front
# of this before it faces the internet: the stack speaks plain HTTP, and every
# login on it would cross the network in the clear.
WEB_PORT=8080

# How many reverse proxies sit in front of the API.
#
# 0 (the default) trusts nothing and is correct when the API is exposed
# directly. The compose stack sets 1, because nginx is one hop in front; with 0
# there, every request looks like it came from nginx and the throttler gives
# the whole Institute one shared budget.
#
# It is a HOP COUNT rather than a boolean on purpose: a client can write
# anything into X-Forwarded-For, so trusting the header outright would let an
# attacker change their apparent address per request and step around the rate
# limit meant to stop them.
TRUST_PROXY_HOPS=0

# --- Rate limits -----------------------------------------------------------
# Public application submissions allowed per hour, per client address. It counts
# ATTEMPTS, not applications: a submission refused for a mistyped CNIC uses one
# up. Raise it if applicants share a connection — a computer lab or an internet
# café is one address for everybody in the room.
APPLY_LIMIT_PER_HOUR=10

# The general authenticated ceiling, per minute per address (§7.7). An institute
# whose students sit behind one NAT shares a single budget, so raise it there.
THROTTLE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------- classes
# Live classes. See INTEGRATIONS.md section 3.
#
# Creating a Google Meet link means acting as a REAL PERSON: a service
# account cannot, and Google refuses with "Invalid conference type value".
# Two ways to give the System somebody to act as, and either is enough.
#
# A) Sign in once. No Workspace admin needed, works on any Google account:
#      node -r dotenv/config scripts/google-authorise.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# As sensitive as that account's password. Never commit it.
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# B) Domain-wide delegation, set up by a Workspace super admin. Then this is
#    the user whose calendar holds the classes.
GOOGLE_IMPERSONATE_SUBJECT=

GOOGLE_CALENDAR_ID=primary
# manual until the Calendar adapter lands: the teacher pastes the link and
# everything else about the class works unchanged.
LIVE_PROVIDER=manual
