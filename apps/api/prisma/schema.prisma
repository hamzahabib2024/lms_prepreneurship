// ---------------------------------------------------------------------------
// Data model — SRS-LMS-001 v2.1, Section 8.
//
// Conventions (§8.1), applied throughout:
//   DB-002  surrogate UUID primary key; natural keys carry unique constraints
//   DB-003  UUIDs are non-guessable in URLs (SEC-AUZ-004)
//   DB-004  every table carries created/updated audit columns
//   DB-005  soft deletion via deletedAt (BR-DAT-02)
//   DB-006  all timestamps UTC
//   DB-007  money is Decimal(12,2), never a float
//   DB-008  enumerations are named, not integer codes
//   DB-009  foreign keys are enforced with an explicit onDelete
//
// PostgreSQL 16 is mandated (§3.11): §8.4 needs partial and BRIN indexes and
// DB-017 needs native partitioning. Those are applied in raw SQL migrations,
// since Prisma cannot express them — see prisma/migrations/.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================== enumerations ==

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  WITHDRAWN
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

/// What an applicant has already studied (FR-REG-003).
///
/// Dars-e-Nizami and Hifz-e-Quran are listed rather than folded into OTHER: a
/// madrasah graduate applying for a web development track is a normal applicant
/// here, and they are the two the Institute most needs to count honestly.
enum EducationLevel {
  MATRIC
  FSC
  BACHELORS
  DARS_E_NIZAMI
  HIFZ_E_QURAN
  OTHER
}

enum RegistrationStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AcquisitionSource {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  OTHER
}

enum RejectionReason {
  PAYMENT_NOT_RECEIVED
  AMOUNT_INSUFFICIENT
  SLIP_ILLEGIBLE
  DUPLICATE_APPLICATION
  INELIGIBLE
  SECTION_FULL
  OTHER
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_DEPOSIT
  CHEQUE
  OTHER
}

enum DocumentType {
  PAYMENT_SLIP
  ID_DOCUMENT
  QUALIFICATION
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
  WEEKEND
}

enum GenderRestriction {
  MALE
  FEMALE
  MIXED
}

enum DeliveryMode {
  ONLINE
  HYBRID
  ON_CAMPUS
}

enum SectionStatus {
  PLANNED
  ACTIVE
  CLOSED_FOR_ADMISSION
  ARCHIVED
}

enum EnrolmentStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

enum AssignmentRole {
  PRIMARY
  SUPPORTING
  SUBSTITUTE
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
}

enum AvailabilityStatus {
  AVAILABLE
  MISSING
  CHECKING
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum SessionType {
  ONLINE
  OFFLINE
}

enum AttendancePolicy {
  MANUAL
  SELF_CHECKIN
  PROVIDER_DERIVED
  HYBRID
}

enum BindingStatus {
  PENDING
  ACTIVE
  FAILED
  REVOKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  NOT_MARKED
}

// ARC-033: the SOURCE of the evidence, never the vendor's name. Adding a new
// source later is additive and needs no schema change.
enum MarkingSource {
  MANUAL
  SELF_CHECKIN
  PROVIDER_DERIVED
  AUTOMATED
  IMPORTED
}

// =============================================== identity and access (8.3.1)

model User {
  id              String  @id @default(uuid()) @db.Uuid
  email           String  @unique
  passwordHash    String  @map("password_hash")
  fullName        String  @map("full_name") @db.VarChar(200)
  phone           String? @db.VarChar(20)
  phoneIsWhatsapp Boolean @default(false) @map("phone_is_whatsapp")

  status       UserStatus @default(INVITED)
  statusReason String?    @map("status_reason") @db.Text

  mustChangePassword Boolean   @default(true) @map("must_change_password") // FR-REG-040
  passwordChangedAt  DateTime? @map("password_changed_at")

  mfaEnabled       Boolean @default(false) @map("mfa_enabled") // SEC-AUT-011
  mfaSecret        String? @map("mfa_secret") // encrypted at rest (SEC-CRY-004)
  mfaRecoveryCodes Json?   @map("mfa_recovery_codes") // hashed, single-use (SEC-AUT-012)

  failedLoginCount Int       @default(0) @map("failed_login_count") // SEC-AUT-008
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")

  photoUrl String? @map("photo_url") @db.VarChar(500)
  locale   String  @default("en") @db.VarChar(10)
  timezone String  @default("Asia/Karachi") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  roles    UserRole[]
  sessions UserSession[]
  studentNotes StudentNote[]
  announcements          Announcement[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  student  Student?
  teacher  Teacher?

  discussionPosts DiscussionPost[]
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique @db.VarChar(50) // super_admin | admin | teacher | student
  name     String  @db.VarChar(100)
  isSystem Boolean @default(true) @map("is_system") // system roles cannot be deleted

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  // §4.2.2 — individually granted admin sub-permissions.
  subPermissions String[] @default([]) @map("sub_permissions")

  grantedBy String?   @map("granted_by") @db.Uuid // FR-RBAC-010
  expiresAt DateTime? @map("expires_at") // FR-RBAC-013 temporary delegation

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model UserSession {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  refreshTokenHash String  @unique @map("refresh_token_hash") // never stored in plaintext
  tokenFamilyId    String  @map("token_family_id") @db.Uuid // SEC-AUT-004 rotation family
  deviceLabel      String? @map("device_label") @db.VarChar(200)
  ipAddress        String? @map("ip_address") @db.VarChar(64)
  userAgent        String? @map("user_agent") @db.VarChar(500)

  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ======================================================== admission (8.3.2)

model RegistrationRequest {
  id          String             @id @default(uuid()) @db.Uuid
  trackingRef String             @unique @map("tracking_ref") @db.VarChar(20) // FR-REG-018
  status      RegistrationStatus @default(PENDING_REVIEW)

  fullName        String   @map("full_name") @db.VarChar(200)
  fatherName      String   @map("father_name") @db.VarChar(200)
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  gender          Gender // drives section eligibility (FR-CRS-009)
  nationalId      String   @map("national_id") @db.VarChar(20) // encrypted; masked in lists (SEC-PRV-005)
  phone           String   @db.VarChar(20)
  // FR-REG-003 — the WhatsApp-capable indicator. Carried on the application
  // itself because credentials are relayed over WhatsApp at approval
  // (FR-REG-042), so the reviewer needs to know before the account exists.
  phoneIsWhatsapp Boolean  @default(true) @map("phone_is_whatsapp")
  altPhone        String?  @map("alt_phone") @db.VarChar(20)
  email           String
  address         String   @db.VarChar(500)
  city            String   @db.VarChar(100)
  /// The level, from a fixed list, because this is what gets counted.
  /// Nullable only so applications submitted before it existed still read.
  educationLevel  EducationLevel? @map("education_level")
  /// The detail beside it — the subject, the board, the year.
  qualification   String   @db.VarChar(120)
  occupation      String?  @db.VarChar(120)

  desiredProgrammeId String? @map("desired_programme_id") @db.Uuid
  desiredSectionId   String? @map("desired_section_id") @db.Uuid

  acquisitionSource AcquisitionSource @map("acquisition_source")
  acquisitionDetail String?           @map("acquisition_detail") @db.VarChar(255)
  campaignRef       Json?             @map("campaign_ref") // auto-captured UTM data (FR-REG-006)

  // The applicant's CLAIM. Not a fact — see Payment for the verified values.
  claimedAmount      Decimal  @map("claimed_amount") @db.Decimal(12, 2)
  claimedPaymentDate DateTime @map("claimed_payment_date") @db.Date
  claimedBankRef     String?  @map("claimed_bank_ref") @db.VarChar(100)

  consentVersion String   @map("consent_version") @db.VarChar(20) // SEC-PRV-003
  consentAt      DateTime @map("consent_at")

  // FR-REG-026 — review claim, so two admins cannot act on one request.
  claimedByUserId String?   @map("claimed_by_user_id") @db.Uuid
  claimedUntil    DateTime? @map("claimed_until")

  decision           RegistrationStatus?
  decisionReasonCode RejectionReason?    @map("decision_reason_code")
  decisionNote       String?             @map("decision_note") @db.Text
  decidedBy          String?             @map("decided_by") @db.Uuid
  decidedAt          DateTime?           @map("decided_at")

  /// FR-REG-045 — the student this request admitted.
  ///
  /// NOT unique. It was, on the assumption that one request produces one new
  /// student — but a student may take more than one course, and their second
  /// admission points at the record they already have. The unique constraint
  /// made that impossible: the second approval failed with "a record with that
  /// value already exists" and an administrator had no way forward.
  ///
  /// "Created" is now read as "resulted in": for a returning student the
  /// request enrolled them rather than creating them.
  createdStudentId String? @map("created_student_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  desiredProgramme Programme?             @relation(fields: [desiredProgrammeId], references: [id], onDelete: SetNull)
  desiredSection   Section?               @relation(fields: [desiredSectionId], references: [id], onDelete: SetNull)
  createdStudent   Student?               @relation(fields: [createdStudentId], references: [id], onDelete: SetNull)
  documents        RegistrationDocument[]
  payments         Payment[]

  @@index([status, createdAt]) // the review queue, oldest first (FR-REG-022)
  @@index([nationalId]) // duplicate detection (FR-REG-016)
  @@index([email])
  @@index([phone])
  @@map("registration_requests")
}

model RegistrationDocument {
  id String @id @default(uuid()) @db.Uuid

  /// NULLABLE, and this is the whole reason the public application never
  /// worked. A slip is uploaded BEFORE the application exists — the applicant
  /// attaches it, then fills in the form — so requiring a request id here made
  /// it impossible to create one. The submit schema demands at least one slip
  /// id, nothing could produce one, and the endpoint was unreachable.
  ///
  /// An unattached row is claimed by the submission that names it, and only
  /// while it is still unattached (FR-REG-008).
  registrationRequestId String?      @map("registration_request_id") @db.Uuid
  documentType          DocumentType @default(PAYMENT_SLIP) @map("document_type")

  storageKey       String     @map("storage_key") @db.VarChar(500) // never a public URL (SEC-FIL-009)
  originalFilename String     @map("original_filename") @db.VarChar(255) // sanitised; never used as a path
  contentType      String     @map("content_type") @db.VarChar(100) // determined by content (SEC-FIL-003)
  sizeBytes        BigInt     @map("size_bytes")
  contentHash      String     @map("content_hash") @db.VarChar(64) // SHA-256
  scanStatus       ScanStatus @default(PENDING) @map("scan_status") // SEC-FIL-004

  createdAt DateTime @default(now()) @map("created_at")

  registrationRequest RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)

  @@index([registrationRequestId])
  @@index([contentHash])
  @@map("registration_documents")
}

// BR-PAY-05: never deleted. A reversal marks the row and retains it.
model Payment {
  id                    String  @id @default(uuid()) @db.Uuid
  studentId             String  @map("student_id") @db.Uuid
  registrationRequestId String? @map("registration_request_id") @db.Uuid

  verifiedAmount Decimal       @map("verified_amount") @db.Decimal(12, 2) // authoritative (BR-REG-10)
  currency       String        @default("PKR") @db.Char(3)
  paymentDate    DateTime      @map("payment_date") @db.Date
  method         PaymentMethod
  bankReference  String?       @map("bank_reference") @db.VarChar(100)

  verifiedBy     String   @map("verified_by") @db.Uuid
  verifiedAt     DateTime @default(now()) @map("verified_at")
  varianceReason String?  @map("variance_reason") @db.Text // required when verified != claimed (FR-REG-028)

  isReversed     Boolean   @default(false) @map("is_reversed")
  reversedBy     String?   @map("reversed_by") @db.Uuid
  reversedAt     DateTime? @map("reversed_at")
  reversalReason String?   @map("reversal_reason") @db.Text

  /// Allocated the first time a receipt is issued, then NEVER changed: a
  /// student holding a printed receipt and the Institute's copy must show the
  /// same number. Nullable because payments recorded before receipts existed
  /// have none until one is asked for (FR-PAY-039).
  receiptNo       String?   @unique @map("receipt_no") @db.VarChar(50)
  receiptIssuedAt DateTime? @map("receipt_issued_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student             Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  registrationRequest RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: SetNull)

  @@index([studentId, paymentDate])
  @@map("payments")
}

// =============================================== academic structure (8.3.3)

model Student {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // FR-REG-052: permanent. Never reused, recycled, or reissued.
  registrationNo         String  @unique @map("registration_no") @db.VarChar(50)
  registrationNoPrevious String? @map("registration_no_previous") @db.VarChar(50) // alias after a correction

  // Denormalised for query performance (§8.5); authoritative source is Enrolment.
  currentSectionId String? @map("current_section_id") @db.Uuid
  currentRollNo    Int?    @map("current_roll_no") @db.SmallInt

  nationalId    String   @unique @map("national_id") @db.VarChar(20)
  dateOfBirth   DateTime @map("date_of_birth") @db.Date
  gender        Gender
  guardianName  String?  @map("guardian_name") @db.VarChar(200)
  guardianPhone String?  @map("guardian_phone") @db.VarChar(20)
  admissionDate DateTime @map("admission_date") @db.Date

  outstandingBalance Decimal @default(0) @map("outstanding_balance") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  currentSection Section?             @relation(fields: [currentSectionId], references: [id], onDelete: SetNull)
  enrolments     Enrolment[]
  payments       Payment[]
  attendance      AttendanceRecord[]
  watchProgress   WatchProgress[]
  submissionFiles SubmissionFile[]
  submissions     AssignmentSubmission[]
  extensions      AssignmentExtension[]
  quizAttempts    QuizAttempt[]
  certificates    Certificate[]
  attendanceWarnings AttendanceWarning[]
  /// Plural now: a student who takes a second course was admitted by a second
  /// request, and both point at the same record.
  registrations   RegistrationRequest[]
  feeCharges      FeeCharge[]
  notes           StudentNote[]

  // FR-REG-057: roll numbers are unique within a section and reusable after
  // withdrawal. Enforced as a partial unique index in raw SQL (live rows only).
  @@index([currentSectionId, currentRollNo])
  @@index([registrationNoPrevious])
  @@map("students")
}

/// A staff note about a student — FR-REG-046, §4.5 `internal_note`.
///
/// THE STUDENT MUST NEVER SEE THIS, and that is the only reason the model
/// exists separately rather than as a column on Student. A pastoral note
/// ("struggling since her father's illness — allow extra time") is written so
/// staff can help, and is exactly the kind of text that causes harm if the
/// person it describes reads it. §4.5 grants `internal_note` to Super Admin,
/// Admin and Teacher and to NOBODY ELSE; the scope policy denies students
/// outright rather than relying on that alone.
///
/// ANCHORED TO A SECTION-SUBJECT, not just to a student. A teacher's authority
/// is ASSIGNED scope (BR-ACC-04) — bound to a subject WITHIN a section — so a
/// note has to record which of their classes it was written from, otherwise
/// there is no way to decide which teacher may later read it.
model StudentNote {
  id               String @id @default(uuid()) @db.Uuid
  studentId        String @map("student_id") @db.Uuid
  sectionSubjectId String @map("section_subject_id") @db.Uuid
  authorUserId     String @map("author_user_id") @db.Uuid

  body String @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft, like everything else a person wrote (BR-DAT-04).
  deletedAt DateTime? @map("deleted_at")

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Restrict)
  author         User           @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([studentId, deletedAt])
  @@index([sectionSubjectId])
  @@map("student_notes")
}

model Teacher {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  employeeCode   String?  @unique @map("employee_code") @db.VarChar(50)
  qualifications String?  @db.Text
  joinedAt       DateTime @map("joined_at") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments TeacherAssignment[]
  sessions    LiveSession[]

  @@map("teachers")
}

model Programme {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(200)
  code          String  @unique @db.VarChar(10) // used in registration numbering
  description   String? @db.Text
  durationWeeks Int?    @map("duration_weeks")
  isActive      Boolean @default(true) @map("is_active")

  /// The picture on the landing page and the application form. Uploaded through
  /// the System rather than pasted as a URL, so the Institute does not depend on
  /// somebody's Drive share staying public for its own prospectus to render.
  thumbnailAssetId String? @map("thumbnail_asset_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions      AcademicSession[]
  registrations RegistrationRequest[]
  certificates  Certificate[]
  feeStructures FeeStructure[]
  thumbnail     MediaAsset?          @relation(fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@index([thumbnailAssetId])
  @@map("programmes")
}

model AcademicSession {
  id          String   @id @default(uuid()) @db.Uuid
  programmeId String   @map("programme_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(10) // SP26, FA26 — used in numbering
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  status      String   @default("PLANNED") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  programme     Programme      @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  feeCharges    FeeCharge[]
  feeStructures FeeStructure[]
  batches       Batch[]

  @@unique([programmeId, code])
  @@map("academic_sessions")
}

model Batch {
  id                String @id @default(uuid()) @db.Uuid
  academicSessionId String @map("academic_session_id") @db.Uuid
  name              String @db.VarChar(150)
  deliveryPattern   String @map("delivery_pattern") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  sections        Section[]

  @@index([academicSessionId])
  @@map("batches")
}

model Section {
  id      String @id @default(uuid()) @db.Uuid
  batchId String @map("batch_id") @db.Uuid
  code    String @unique @db.VarChar(40) // SP26-DM-EVE-A
  name    String @db.VarChar(150)

  capacity      Int @db.SmallInt
  enrolledCount Int @default(0) @map("enrolled_count") @db.SmallInt // materialised (§8.5)

  genderRestriction GenderRestriction @default(MIXED) @map("gender_restriction") // absolute (FR-CRS-009)
  shift             Shift
  deliveryMode      DeliveryMode      @default(ONLINE) @map("delivery_mode")
  attributes        Json? // extensible tags (FR-CRS-007)

  whatsappChannelUrl String? @map("whatsapp_channel_url") @db.VarChar(500)
  whatsappGroupUrl   String? @map("whatsapp_group_url") @db.VarChar(500)

  status SectionStatus @default(PLANNED)

  // ARC-027 — per-section provider override, so migration can be gradual.
  liveProviderKey String? @map("live_provider_key") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  batch           Batch                 @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sectionSubjects SectionSubject[]
  students        Student[]
  registrations   RegistrationRequest[]
  announcements   Announcement[]

  @@index([batchId])
  @@index([status])
  @@map("sections")
}

model Subject {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(200)
  code         String  @unique @db.VarChar(20)
  description  String? @db.Text
  credits      Int?    @db.SmallInt
  /// An EXTERNAL picture, pasted as a URL. Kept because some subjects are
  /// illustrated from the Institute's own site, and dropping it would break
  /// those. `thumbnailAssetId` below is the uploaded one, and wins when set.
  thumbnailUrl     String? @map("thumbnail_url") @db.VarChar(500)
  thumbnailAssetId String? @map("thumbnail_asset_id") @db.Uuid
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sectionSubjects SectionSubject[]
  modules         Module[]
  thumbnail       MediaAsset?      @relation(fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@index([thumbnailAssetId])
  @@map("subjects")
}

/// The offering of a Subject to a Section — the pivot of the whole model.
/// Assessment, sessions, attendance and announcements all hang off THIS,
/// not off Subject, because they concern a specific group at a specific time
/// (BR-CNT-03).
model SectionSubject {
  id           String  @id @default(uuid()) @db.Uuid
  sectionId    String  @map("section_id") @db.Uuid
  subjectId    String  @map("subject_id") @db.Uuid
  isCompulsory Boolean @default(true) @map("is_compulsory") // drives auto-enrolment (FR-CRS-019)

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("PLANNED") @db.VarChar(20)

  /// The folder recordings for this class are put in — a Drive folder id, or a
  /// path under local storage. When it is set, a lecture appears on the course
  /// page as soon as the file appears in the folder (LectureSyncService).
  ///
  /// Null means nobody has connected one, and the sweep skips the class
  /// entirely rather than guessing at a folder.
  lectureFolderRef String? @map("lecture_folder_ref") @db.VarChar(255)

  progressWeights    Json? @map("progress_weights") // per-subject override of Figure 5-3
  completionCriteria Json? @map("completion_criteria") // FR-PRG-009

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  section     Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assignments   TeacherAssignment[]
  enrolments    Enrolment[]
  sessions      LiveSession[]
  certificates  Certificate[]
  announcements Announcement[]
  attendanceWarnings AttendanceWarning[]
  studentNotes       StudentNote[]

  discussionPosts DiscussionPost[]
  @@unique([sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("section_subjects")
}

/// BR-ACC-04: THE SOLE SOURCE OF `ASSIGNED` SCOPE.
///
/// A teacher's authority derives from an assignment to a subject WITHIN a
/// section — never from the subject alone. Getting this wrong is a security
/// defect, not a modelling preference, and it is the single most frequently
/// mis-implemented rule in systems of this kind.
model TeacherAssignment {
  id               String         @id @default(uuid()) @db.Uuid
  teacherId        String         @map("teacher_id") @db.Uuid
  sectionSubjectId String         @map("section_subject_id") @db.Uuid
  assignmentRole   AssignmentRole @default(PRIMARY) @map("assignment_role")

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date // expiry withdraws scope automatically (FR-CRS-025)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Restrict)

  @@unique([teacherId, sectionSubjectId, startDate])
  // The hottest authorisation path in the System — scope resolution on every
  // single request.
  @@index([teacherId, endDate])
  @@index([sectionSubjectId])
  @@map("teacher_assignments")
}

model Enrolment {
  id               String          @id @default(uuid()) @db.Uuid
  studentId        String          @map("student_id") @db.Uuid
  sectionSubjectId String          @map("section_subject_id") @db.Uuid
  status           EnrolmentStatus @default(ACTIVE)

  rollNoAtEnrolment Int?      @map("roll_no_at_enrolment") @db.SmallInt // historical, across transfers
  enrolledAt        DateTime  @default(now()) @map("enrolled_at")
  endedAt           DateTime? @map("ended_at")
  statusReason      String?   @map("status_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Restrict)

  // FR-ENR-016: no duplicate ACTIVE enrolment. Enforced as a partial unique
  // index in raw SQL (WHERE status = 'ACTIVE'), which Prisma cannot express.
  @@index([studentId, status])
  @@index([sectionSubjectId, status])
  @@map("enrolments")
}

// ======================================================== content (8.3.4) ==

model Module {
  id                String            @id @default(uuid()) @db.Uuid
  subjectId         String            @map("subject_id") @db.Uuid
  title             String            @db.VarChar(255)
  description       String?           @db.Text
  displayOrder      Int               @map("display_order")
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status") // BR-CNT-01
  publishAt         DateTime?         @map("publish_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@index([subjectId, displayOrder])
  @@map("modules")
}

model Lesson {
  id                   String            @id @default(uuid()) @db.Uuid
  moduleId             String            @map("module_id") @db.Uuid
  title                String            @db.VarChar(255)
  description          String?           @db.Text
  displayOrder         Int               @map("display_order")
  estimatedMinutes     Int?              @map("estimated_minutes") @db.SmallInt
  publicationStatus    PublicationStatus @default(DRAFT) @map("publication_status")
  publishAt            DateTime?         @map("publish_at")
  prerequisiteLessonId String?           @map("prerequisite_lesson_id") @db.Uuid // FR-CRS-032 sequential release

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  module   Module            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  lectures  RecordedLecture[]
  sessions  LiveSession[]
  resources LessonResource[]

  @@index([moduleId, displayOrder])
  @@map("lessons")
}

/// A catalogue entry. The video bytes stay in Google Drive (CON-01, ARC-037).
model RecordedLecture {
  id               String  @id @default(uuid()) @db.Uuid
  lessonId         String? @map("lesson_id") @db.Uuid // may exist before binding (FR-VID-005)
  sectionSubjectId String  @map("section_subject_id") @db.Uuid
  liveSessionId    String? @unique @map("live_session_id") @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  storageProvider String @default("google_drive") @map("storage_provider") @db.VarChar(50)
  /// Opaque provider file id. ARC-041: NEVER exposed to a student in any
  /// response, page source, or client-side state.
  storageRef      String @map("storage_ref") @db.VarChar(255)

  durationSeconds Int?     @map("duration_seconds")
  recordedOn      DateTime @map("recorded_on") @db.Date
  teacherId       String?  @map("teacher_id") @db.Uuid

  publicationStatus  PublicationStatus  @default(DRAFT) @map("publication_status")
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status") // ARC-045
  lastVerifiedAt     DateTime?          @map("last_verified_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lesson        Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  liveSession   LiveSession?    @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  watchProgress WatchProgress[]

  @@index([sectionSubjectId, publicationStatus])
  @@index([recordedOn])
  @@map("recorded_lectures")
}

/// FR-VID-008/009/010 — how much of a lecture a student has actually watched.
///
/// `watchedIntervals` holds MERGED, non-overlapping [start, end] pairs in
/// seconds, not a running total. The distinction is the whole point: a total
/// cannot tell scrubbing to the end apart from watching the middle, and
/// `watchedPercent` feeds the video component of progress, which decides
/// certification (BR-PRG-02). A student has an incentive to inflate it, so the
/// server merges the intervals itself and never stores a client-sent
/// percentage.
/// FR-CRS-035 — a file attached to a lesson: slides, a handout, a worksheet.
///
/// Distinct from RecordedLecture, which is the video and lives per OFFERING. A
/// lesson belongs to a module and a module to a SUBJECT, so a handout is
/// subject-level and every section studying that subject gets it.
///
/// It carries its own publicationStatus as well as sitting under the lesson's.
/// A teacher uploading next week's worksheet to an already-published lesson
/// must not have it appear the moment the upload finishes.
model LessonResource {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  /// Never a public URL (SEC-FIL-009). Resolved through the storage adapter.
  storageKey       String @map("storage_key") @db.VarChar(500)
  originalFilename String @map("original_filename") @db.VarChar(255)
  /// Determined by CONTENT, not by the extension (SEC-FIL-003).
  contentType      String @map("content_type") @db.VarChar(100)
  sizeBytes        BigInt @map("size_bytes")
  contentHash      String @map("content_hash") @db.VarChar(64)

  displayOrder      Int               @default(0) @map("display_order")
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")

  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([lessonId, displayOrder])
  @@map("lesson_resources")
}

model WatchProgress {
  id                String @id @default(uuid()) @db.Uuid
  studentId         String @map("student_id") @db.Uuid
  recordedLectureId String @map("recorded_lecture_id") @db.Uuid

  /// Interval[] — [{ start, end }], merged and sorted. See watch-intervals.ts.
  watchedIntervals Json @default("[]") @map("watched_intervals")

  watchedPercent      Decimal @default(0) @map("watched_percent") @db.Decimal(5, 2)
  lastPositionSeconds Int     @default(0) @map("last_position_seconds")

  /// Latched: once true it stays true. Re-watching part of a lecture must not
  /// take a completion away, or progress would move backwards (BR-PRG-05).
  isComplete  Boolean   @default(false) @map("is_complete")
  completedAt DateTime? @map("completed_at")

  firstWatchedAt DateTime @default(now()) @map("first_watched_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedLecture RecordedLecture @relation(fields: [recordedLectureId], references: [id], onDelete: Cascade)

  /// One row per student per lecture — the upsert target.
  @@unique([studentId, recordedLectureId])
  @@index([recordedLectureId, isComplete])
  @@map("watch_progress")
}

/// A completion certificate — SRS §5.15, FR-CRT-001..020.
///
/// THE FIGURES ARE A SNAPSHOT, NOT A POINTER.
///
/// Progress is derived and computed on read (ARC-007, DB-011): it changes when
/// a teacher publishes another lecture, when a register is corrected, when a
/// mark is revised. A certificate is a statement about a MOMENT — "this student
/// met the requirements on this date" — so it carries its own copies of the
/// evidence. Pointing at the live figures would mean a certificate silently
/// saying something different next term from what was printed and handed over.
model Certificate {
  id            String @id @default(uuid()) @db.Uuid
  /// The permanent public identifier, printed on the document.
  certificateNo String @unique @map("certificate_no") @db.VarChar(50)

  studentId String          @map("student_id") @db.Uuid
  type      CertificateType

  /// Exactly one of these is set, per the type.
  sectionSubjectId String? @map("section_subject_id") @db.Uuid
  programmeId      String? @map("programme_id") @db.Uuid

  /// What was true at the moment of issue (FR-CRT-008).
  progressPercent     Decimal  @map("progress_percent") @db.Decimal(5, 2)
  attendancePercent   Decimal? @map("attendance_percent") @db.Decimal(5, 2)
  averageGradePercent Decimal? @map("average_grade_percent") @db.Decimal(5, 2)
  /// The criteria themselves, so a challenge years later can be answered with
  /// the rule that was actually applied rather than today's configuration.
  criteriaApplied     Json     @map("criteria_applied")

  status   CertificateStatus @default(ISSUED)
  issuedAt DateTime          @default(now()) @map("issued_at")
  issuedBy String            @map("issued_by") @db.Uuid

  /// BR-DAT-02 — revoked, never deleted. A certificate that vanished would
  /// leave an employer holding a document the System denies exists.
  revokedAt        DateTime? @map("revoked_at")
  revokedBy        String?   @map("revoked_by") @db.Uuid
  revocationReason String?   @map("revocation_reason") @db.Text

  /// FR-CRT-015 — quoted by an employer to confirm the document is genuine,
  /// without an account. Separate from certificateNo so the printed number can
  /// be human-friendly while the check remains unguessable (SEC-AUZ-004).
  verificationCode String @unique @map("verification_code") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sectionSubject SectionSubject? @relation(fields: [sectionSubjectId], references: [id], onDelete: Restrict)
  programme      Programme?      @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  /// FR-CRT-004 — at most one LIVE certificate per student per thing.
  ///
  /// Expressed as PARTIAL unique indexes in the migration, not here: Prisma
  /// cannot write `WHERE status = 'ISSUED'`, and a plain unique over
  /// (student, subject, status) would allow only one REVOKED row too — so
  /// issue, revoke, reissue, revoke would collide on the second revocation.
  @@index([studentId])
  @@index([issuedAt])
  @@map("certificates")
}

/// An announcement — SRS §5.16, FR-COM-001..012.
///
/// Addressed to an AUDIENCE, never to a list of people. A teacher announces to
/// the subject-section they teach; who is enrolled in it at the moment of
/// sending is a question the System answers, and a student who enrols the next
/// day sees it too. Storing a resolved recipient list would freeze the audience
/// at composition time and quietly exclude them.
model Announcement {
  id       String               @id @default(uuid()) @db.Uuid
  audience AnnouncementAudience

  /// Set according to the audience. INSTITUTE leaves both null.
  sectionId        String? @map("section_id") @db.Uuid
  sectionSubjectId String? @map("section_subject_id") @db.Uuid

  title String @db.VarChar(200)
  body  String @db.Text

  /// FR-COM-006 — pinned to the top until the author unpins it. A separate
  /// axis from `priority`: a normal notice can be worth keeping at the top
  /// (the term dates), and an urgent one usually is not (it passes).
  isPinned Boolean @default(false) @map("is_pinned")

  /// NORMAL | IMPORTANT | URGENT — how much this matters, and how loudly the
  /// card says so.
  ///
  /// `isUrgent` below is DERIVED FROM THIS by the service and kept in step,
  /// rather than being a second decision that can disagree with it. It stays
  /// because it carries a behaviour rather than a colour: BR-COM-02 makes an
  /// urgent announcement ignore a recipient's quiet hours, and that rule is
  /// read by the notification fan-out and the delivery record.
  priority String @default("NORMAL") @db.VarChar(20)

  /// BR-COM-02 — an urgent announcement ignores a quiet-hours suppression.
  isUrgent Boolean @default(false) @map("is_urgent")

  /// Also shown on the PUBLIC page, to people with no account.
  ///
  /// Defaults to false, and that direction matters: an announcement is written
  /// for the people inside the Institute, and most of them — a room change, a
  /// missing assignment, a fee deadline — would be at best meaningless and at
  /// worst embarrassing on the front page. Publishing is a second, deliberate
  /// act rather than the absence of a decision.
  ///
  /// Only an INSTITUTE announcement may carry it. One addressed to a section
  /// is addressed to those students, and putting it on a public page tells
  /// strangers something about a class that was said to a class.
  isPublic Boolean @default(false) @map("is_public")

  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  authorUserId String @map("author_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  section        Section?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionSubject SectionSubject? @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)
  author         User            @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  notifications  Notification[]

  @@index([audience, publishedAt])
  @@index([sectionSubjectId, publishedAt])
  @@map("announcements")
}

/// One person's copy of one thing they need to know — FR-COM-013..020.
///
/// Written per RECIPIENT rather than per event, because "have I read it?" and
/// "was it delivered to me?" are properties of a person, not of the event. It
/// is also what makes the in-app inbox the system of record: WhatsApp and email
/// are DELIVERIES of a notification, not the notification itself, so a failed
/// send never loses the message.
model Notification {
  id          String @id @default(uuid()) @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  /// A stable machine key — "assignment.due_soon", "grade.released". The
  /// interface routes on this; the text below is what a person reads.
  kind  String @db.VarChar(60)
  title String @db.VarChar(200)
  body  String @db.Text

  /// Where reading it should take the recipient. Relative, and never a
  /// provider URL (ARC-023).
  linkPath String? @map("link_path") @db.VarChar(500)

  announcementId String? @map("announcement_id") @db.Uuid

  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  recipient    User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  /// The inbox query: this person's, newest first, unread first.
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

/// An attempt to push a notification down a channel — ARC-046.
///
/// Separate from Notification for the same reason storage is separate from the
/// catalogue: the channel is a configuration choice, not a fact about the
/// message. Adding WhatsApp means an adapter and a row here, and nothing else
/// in the System becomes aware of it.
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)

  /// Why it did not go. SUPPRESSED is not a failure — it is the System
  /// honouring a preference or quiet hours, and must not read as an error.
  detail      String?   @db.Text
  attemptedAt DateTime? @map("attempted_at")

  createdAt DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

/// What a person wants to be told about, and how — FR-COM-018.
model NotificationPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Channels the user accepts. IN_APP is not listed because it cannot be
  /// switched off: the inbox is the record, and a message nobody can retrieve
  /// has not been delivered.
  channels String[] @default(["WHATSAPP"])

  /// Kinds the user has muted. A kind absent from this list is delivered.
  mutedKinds String[] @default([]) @map("muted_kinds")

  /// BR-COM-02 — local time, inclusive start, exclusive end. Suppresses
  /// non-urgent pushes only; the inbox copy is written regardless.
  quietHoursStart Int? @map("quiet_hours_start") @db.SmallInt
  quietHoursEnd   Int? @map("quiet_hours_end") @db.SmallInt

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// A live attendance warning — SRS FR-ATT-020/022, Appendix F.
///
/// ONE ROW PER STUDENT PER SUBJECT, holding the level they currently sit at.
/// It exists so the System can tell a TRANSITION from a STATE: thresholds are
/// re-evaluated on every register a teacher marks, and without somewhere to
/// remember what was already said, a struggling student would be notified after
/// every single class until they stopped reading.
///
/// clearedAt records a recovery rather than deleting the row, so a relapse can
/// be recognised as new information and warned about again.
model AttendanceWarning {
  id               String @id @default(uuid()) @db.Uuid
  studentId        String @map("student_id") @db.Uuid
  sectionSubjectId String @map("section_subject_id") @db.Uuid

  severity WarningSeverity
  /// What the figure was when this level was reached — the evidence for the
  /// message that was sent.
  percentage         Decimal @map("percentage") @db.Decimal(5, 2)
  thresholdApplied   Decimal @map("threshold_applied") @db.Decimal(5, 2)

  raisedAt  DateTime  @default(now()) @map("raised_at")
  /// Set when the student climbs back above the threshold. A cleared row is
  /// history, not a live warning.
  clearedAt DateTime? @map("cleared_at")

  /// FR-ATT-022 — a teacher recording that they have acted on it.
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionSubjectId])
  @@index([sectionSubjectId, severity, clearedAt])
  @@map("attendance_warnings")
}

// ================================================== live sessions (8.3.4) ==

/// PROVIDER-AGNOSTIC BY MANDATE (ARC-023).
///
/// No column in this model names or implies a conferencing vendor. Everything
/// vendor-specific lives in LiveSessionProviderBinding, which is the only
/// provider-aware persisted structure in the System.
model LiveSession {
  id               String  @id @default(uuid()) @db.Uuid
  sectionSubjectId String  @map("section_subject_id") @db.Uuid
  lessonId         String? @map("lesson_id") @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  scheduledStart DateTime  @map("scheduled_start")
  scheduledEnd   DateTime  @map("scheduled_end")
  actualStart    DateTime? @map("actual_start")
  actualEnd      DateTime? @map("actual_end")

  hostTeacherId       String  @map("host_teacher_id") @db.Uuid
  substituteTeacherId String? @map("substitute_teacher_id") @db.Uuid

  status      SessionStatus @default(SCHEDULED)
  sessionType SessionType   @default(ONLINE) @map("session_type")

  joinWindowMinutesBefore Int              @default(15) @map("join_window_minutes_before") @db.SmallInt
  attendancePolicy        AttendancePolicy @default(MANUAL) @map("attendance_policy")

  timetableSlotId    String? @map("timetable_slot_id") @db.Uuid
  cancellationReason String? @map("cancellation_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sectionSubject SectionSubject              @relation(fields: [sectionSubjectId], references: [id], onDelete: Restrict)
  lesson         Lesson?                     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  hostTeacher    Teacher                     @relation(fields: [hostTeacherId], references: [id], onDelete: Restrict)
  binding        LiveSessionProviderBinding?
  attendance     AttendanceRecord[]
  recording      RecordedLecture?

  @@index([sectionSubjectId, scheduledStart])
  @@index([scheduledStart, status])
  @@map("live_sessions")
}

/// The ONLY vendor-aware persisted structure (ARC-024).
///
/// Replacing Google Meet means writing a new adapter and adding a registry
/// entry. It must not require touching any other table, and the substitution
/// test at §3.4.6 verifies exactly that.
model LiveSessionProviderBinding {
  id            String @id @default(uuid()) @db.Uuid
  liveSessionId String @unique @map("live_session_id") @db.Uuid

  providerKey      String  @map("provider_key") @db.VarChar(50) // google_meet | internal_classroom | ...
  externalId       String? @map("external_id") @db.VarChar(255) // provider's own id — opaque to us
  /// Opaque. ARC-025: never parsed, pattern-matched, or validated by the System.
  joinUrl          String? @map("join_url") @db.VarChar(1000)
  hostUrl          String? @map("host_url") @db.VarChar(1000)
  providerMetadata Json?   @map("provider_metadata") // provider's extras; never read by domain code

  status           BindingStatus @default(PENDING)
  isManualFallback Boolean       @default(false) @map("is_manual_fallback") // FR-LIV-018
  lastSyncedAt     DateTime?     @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@map("live_session_provider_bindings")
}

model AttendanceRecord {
  id            String @id @default(uuid()) @db.Uuid
  liveSessionId String @map("live_session_id") @db.Uuid
  studentId     String @map("student_id") @db.Uuid

  status        AttendanceStatus @default(NOT_MARKED)
  markingSource MarkingSource    @default(MANUAL) @map("marking_source") // ARC-033 — no vendor name

  proposedStatus       AttendanceStatus? @map("proposed_status") // provider proposal (FR-ATT-012)
  participationSeconds Int?              @map("participation_seconds")

  markedBy String?   @map("marked_by") @db.Uuid // null where SYSTEM (FR-LOG-005)
  markedAt DateTime? @map("marked_at")

  correctedFrom    AttendanceStatus? @map("corrected_from")
  correctionReason String?           @map("correction_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([liveSessionId, studentId])
  @@index([studentId, status])
  @@map("attendance_records")
}

// ===================================================== governance (8.3.6) ==

/// IMMUTABLE (FR-LOG-004).
///
/// There is no update or delete path for this table in application code, and
/// the migration revokes UPDATE and DELETE at the database privilege level so
/// that application-level compromise cannot alter history.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")

  actorUserId    String? @map("actor_user_id") @db.Uuid // null = SYSTEM principal (§4.2.5)
  actorRole      String? @map("actor_role") @db.VarChar(50) // role held AT THE TIME, not now
  impersonatedBy String? @map("impersonated_by") @db.Uuid // SEC-AUZ-013

  action     String @db.VarChar(80) // e.g. registration.approve
  entityType String @map("entity_type") @db.VarChar(60)
  entityId   String @map("entity_id") @db.VarChar(64)

  beforeValue Json? @map("before_value") // changed fields only (FR-LOG-003)
  afterValue  Json? @map("after_value")

  ipAddress     String? @map("ip_address") @db.VarChar(64)
  userAgent     String? @map("user_agent") @db.VarChar(500)
  correlationId String  @map("correlation_id") @db.Uuid // ARC-008

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

/// SEC-LOG-001 — kept separate from the general audit log.
model SecurityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")

  eventType String  @map("event_type") @db.VarChar(60) // login.failed | lockout | permission.denied
  userId    String? @map("user_id") @db.Uuid
  email     String? // present on failed login where the account may not exist

  outcome       String  @db.VarChar(20)
  detail        Json?
  ipAddress     String? @map("ip_address") @db.VarChar(64)
  userAgent     String? @map("user_agent") @db.VarChar(500)
  correlationId String? @map("correlation_id") @db.Uuid

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([ipAddress, occurredAt])
  @@map("security_events")
}

/// Appendix E — every parameter is changeable through the UI without a
/// deployment (ARC-002, FR-CFG-001).
model Setting {
  id String @id @default(uuid()) @db.Uuid
  /// NOT globally unique. A key exists once per SCOPE — one institute-wide row
  /// and any number of programme, section or subject overrides beside it. It
  /// was declared @unique alongside the scope columns and the compound unique
  /// below, which contradicted both and made an override impossible to insert.
  /// Uniqueness where scope_id IS NULL is a partial index, because SQL does not
  /// consider two NULLs equal (01_constraints_and_indexes.sql).
  key   String @db.VarChar(60)
  value Json

  scopeType String? @map("scope_type") @db.VarChar(30) // INSTITUTE | PROGRAMME | SECTION | SUBJECT
  scopeId   String? @map("scope_id") @db.Uuid

  isSecret Boolean @default(false) @map("is_secret") // write-only through the UI (SEC-CRY-010)

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([key, scopeType, scopeId])
  @@map("settings")
}

/// FR-REG-051 — the atomic counter behind registration numbering.
///
/// Application-level "read max then add one" is FORBIDDEN (Appendix B): it
/// collides under concurrent approval, which is RSK-07. Allocation uses an
/// UPDATE ... RETURNING inside the approval transaction.
/// FR-PAY-020 — what a student owes.
///
/// The Institute had no ledger: Student.outstandingBalance existed from the
/// first migration and nothing ever wrote to it, so the personal-data export
/// told every student they owed nothing and payments were recorded against
/// nothing at all.
///
/// A charge is never deleted (BR-DAT-02). It is WAIVED, which keeps the
/// decision to write it off in the record where somebody can see who made it.
model FeeCharge {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid

  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PKR") @db.Char(3)
  dueDate     DateTime @map("due_date") @db.Date

  /// Optional: the session this belongs to, so a statement can be read by term.
  academicSessionId String? @map("academic_session_id") @db.Uuid

  waivedAt     DateTime? @map("waived_at")
  waivedBy     String?   @map("waived_by") @db.Uuid
  waiverReason String?   @map("waiver_reason") @db.Text

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)

  @@index([studentId, dueDate])
  @@index([dueDate, waivedAt])
  @@map("fee_charges")
}

/// FR-DSC-001 — a question thread on a subject offering.
///
/// One level of replies: a post, and answers to it. Arbitrary nesting makes a
/// thread unreadable on a phone and makes "which question is this answering"
/// ambiguous, which is the only thing a course forum has to get right.
model DiscussionPost {
  id               String @id @default(uuid()) @db.Uuid
  sectionSubjectId String @map("section_subject_id") @db.Uuid
  authorUserId     String @map("author_user_id") @db.Uuid

  /// Null for a top-level question; set for an answer.
  parentPostId String? @map("parent_post_id") @db.Uuid

  /// Only a top-level post has one.
  title String? @db.VarChar(200)
  body  String  @db.Text

  /// FR-DSC-008 — a pinned thread stays at the top of the list.
  isPinned Boolean @default(false) @map("is_pinned")
  /// FR-DSC-009 — closed to further replies. Moderators only.
  isLocked Boolean @default(false) @map("is_locked")

  /// An edited post SAYS SO. A thread whose answers changed after people read
  /// them is unreadable otherwise.
  editedAt DateTime? @map("edited_at")

  /// Set when a moderator removed it rather than the author (FR-DSC-011). The
  /// difference matters to whoever's post disappeared.
  removedByModerator Boolean @default(false) @map("removed_by_moderator")
  removalReason      String? @map("removal_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sectionSubject SectionSubject   @relation(fields: [sectionSubjectId], references: [id], onDelete: Restrict)
  author         User             @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  parent         DiscussionPost?  @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Restrict)
  replies        DiscussionPost[] @relation("PostReplies")

  @@index([sectionSubjectId, isPinned, createdAt])
  @@index([parentPostId, createdAt])
  @@map("discussion_posts")
}

/// ARC-039/040/052 — a short-lived, user-bound permit to stream one lecture.
///
/// IN THE DATABASE, NOT IN MEMORY. It was a Map on the service, which worked
/// exactly as long as there was one process: a ticket minted on one node is
/// invisible to another, so a second instance would refuse roughly half of all
/// playback with "this link has expired". ARC-049 permits the cache to be
/// absent; it does not permit two nodes to disagree about who may watch.
///
/// Redis would be faster and needs provisioning. A table needs nothing that is
/// not already running, and these rows are small, short-lived and swept.
model PlaybackTicket {
  ticketId String @id @map("ticket_id") @db.VarChar(80)

  /// WHO the ticket was issued to — a USER, not a student.
  ///
  /// It was studentId, and required, which meant `issuePlaybackTicket` opened
  /// with "only a student can watch a lecture" and REFUSED THREE OF THE FOUR
  /// ROLES that §4.5 grants lecture_playback:read to. A teacher could publish a
  /// recording to their class and never watch it; an administrator could not
  /// check a single one. A guard nobody can satisfy, again.
  ///
  /// Binding to the user is also what the redemption check wants: it asks
  /// "are you the person this was issued to", and every role has a userId.
  userId String @map("user_id") @db.Uuid

  /// Set only when the viewer is a student, because it is what watch progress
  /// hangs off (FR-VID-008/010). Staff watching a lecture records nothing —
  /// a teacher checking their own recording is not coursework, and counting it
  /// would put their viewing into a student's completion figures.
  studentId         String? @map("student_id") @db.Uuid
  recordedLectureId String  @map("recorded_lecture_id") @db.Uuid
  /// The storage location, which NEVER reaches the client (ARC-041). It lives
  /// here so redeeming the ticket does not have to look the lecture up again.
  storageRef        String  @map("storage_ref") @db.VarChar(500)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@map("playback_tickets")
}

/// The Institute's own wording for a message the System sends (FR-NOT-020).
///
/// Absent means "use the System's default", which is why there is no row per
/// kind by default: a table pre-filled with the defaults would make every
/// message look deliberately chosen, and an Institute could not tell which
/// ones it had actually edited.
model NotificationTemplate {
  id   String @id @default(uuid()) @db.Uuid
  kind String @unique @db.VarChar(60)

  title String @db.VarChar(200)
  body  String @db.Text

  updatedBy String   @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model NumberSeries {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(80) // institute|session|programme|campus

  nextValue Int @default(1) @map("next_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("number_series")
}

// ======================================================== assessment (8.3.5)

enum LatePolicy {
  NOT_ACCEPTED
  FLAG_ONLY
  FIXED_DEDUCTION
  PER_DAY_PERCENT
}

enum SubmissionType {
  FILE
  TEXT
  BOTH
}

enum ResubmissionPolicy {
  NONE
  UNLIMITED_UNTIL_DUE
  LIMITED
}

model Rubric {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(200)
  description    String? @db.Text
  /// FR-ASG-012 — reusable across assignments. Owned by a teacher, or shared
  /// institute-wide when ownerTeacherId is null.
  ownerTeacherId String? @map("owner_teacher_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  criteria    RubricCriterion[]
  assignments Assignment[]

  @@map("rubrics")
}

model RubricCriterion {
  id       String @id @default(uuid()) @db.Uuid
  rubricId String @map("rubric_id") @db.Uuid

  name         String  @db.VarChar(200)
  description  String? @db.Text
  maxMarks     Decimal @map("max_marks") @db.Decimal(6, 2)
  displayOrder Int     @map("display_order")
  /// FR-ASG-014 — an internal criterion is never shown to a student.
  isInternal   Boolean @default(false) @map("is_internal")
  /// Performance-level descriptors, e.g. [{label:"Excellent", marks:10, text:"…"}]
  levels       Json?

  rubric Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@index([rubricId, displayOrder])
  @@map("rubric_criteria")
}

model Assignment {
  id               String  @id @default(uuid()) @db.Uuid
  sectionSubjectId String  @map("section_subject_id") @db.Uuid
  lessonId         String? @map("lesson_id") @db.Uuid

  title          String  @db.VarChar(255)
  instructions   String  @db.Text
  marksAvailable Decimal @map("marks_available") @db.Decimal(6, 2)

  opensAt      DateTime  @map("opens_at")
  dueAt        DateTime  @map("due_at")
  /// FR-ASG-002 — an absolute bar. After this, submission is impossible.
  hardCloseAt  DateTime? @map("hard_close_at")
  graceMinutes Int       @default(0) @map("grace_minutes") @db.SmallInt

  latePolicy       LatePolicy @default(FLAG_ONLY) @map("late_policy")
  latePenaltyValue Decimal?   @map("late_penalty_value") @db.Decimal(6, 2)
  /// The minimum retainable mark, as a percentage of marksAvailable.
  latePenaltyFloor Decimal?   @map("late_penalty_floor") @db.Decimal(6, 2)

  submissionType   SubmissionType @default(FILE) @map("submission_type")
  /// Bounded by the institute-wide policy (Appendix H); a teacher may narrow
  /// it but never widen it (FR-ASG-006).
  allowedFileTypes Json           @map("allowed_file_types")
  maxFileSizeMb    Int            @default(10) @map("max_file_size_mb") @db.SmallInt
  maxFileCount     Int            @default(5) @map("max_file_count") @db.SmallInt

  resubmissionPolicy ResubmissionPolicy @default(NONE) @map("resubmission_policy")
  maxAttempts        Int?               @map("max_attempts") @db.SmallInt

  rubricId String? @map("rubric_id") @db.Uuid

  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  /// BR-ASG-09 — grades are withheld from students until this is set.
  gradesReleased    Boolean           @default(false) @map("grades_released")
  gradesReleasedAt  DateTime?         @map("grades_released_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  rubric      Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]
  extensions  AssignmentExtension[]
  files       SubmissionFile[]

  @@index([sectionSubjectId, publicationStatus])
  @@index([dueAt])
  @@map("assignments")
}

/// FR-ASG-022 / BR-ASG-07 — every version is retained; the latest is graded.
model AssignmentSubmission {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  studentId    String @map("student_id") @db.Uuid

  version  Int     @default(1) @db.SmallInt
  isLatest Boolean @default(true) @map("is_latest")

  /// BR-ASG-04 — SERVER time at completion of upload, never client-supplied.
  submittedAt DateTime @default(now()) @map("submitted_at")
  isLate      Boolean  @default(false) @map("is_late")
  minutesLate Int      @default(0) @map("minutes_late")

  textResponse String? @map("text_response") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  files      SubmissionFile[]
  grade      AssignmentGrade?

  @@unique([assignmentId, studentId, version])
  @@index([assignmentId, isLatest])
  @@index([studentId])
  @@map("assignment_submissions")
}

model SubmissionFile {
  id String @id @default(uuid()) @db.Uuid

  /// NULL until the student presses Submit.
  ///
  /// A file is uploaded first and attached second — FR-ASG-013 lets a student
  /// add files one at a time and see them listed before committing. So an
  /// uploaded file has to be representable before any submission row exists.
  submissionId String? @map("submission_id") @db.Uuid

  /// The owner, recorded at upload. Without it there is no way to answer "may
  /// this caller attach this file?", and attaching by id alone would let one
  /// student pull another's work into their own submission — which would also
  /// REMOVE it from the victim's, since a file has one parent.
  studentId String @map("student_id") @db.Uuid
  /// What it was uploaded FOR. Stops a file uploaded against one assignment
  /// being attached to a different one.
  assignmentId String @map("assignment_id") @db.Uuid

  storageKey       String     @map("storage_key") @db.VarChar(500)
  originalFilename String     @map("original_filename") @db.VarChar(255)
  contentType      String     @map("content_type") @db.VarChar(100)
  sizeBytes        BigInt     @map("size_bytes")
  /// FR-ASG-021 — supports internal duplicate detection and a future external
  /// plagiarism integration.
  contentHash      String     @map("content_hash") @db.VarChar(64)
  scanStatus       ScanStatus @default(PENDING) @map("scan_status")

  createdAt DateTime @default(now()) @map("created_at")

  submission AssignmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  student    Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignment Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([contentHash])
  /// Finds a student's not-yet-attached uploads for one assignment, which is
  /// both the attach path and the orphan sweep.
  @@index([studentId, assignmentId, submissionId])
  @@map("submission_files")
}

model AssignmentGrade {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @unique @map("submission_id") @db.Uuid

  /// FR-ASG-026 — raw, penalty and final are stored separately so a student
  /// can see exactly what the lateness cost them.
  rawMarks       Decimal @map("raw_marks") @db.Decimal(6, 2)
  penaltyApplied Decimal @default(0) @map("penalty_applied") @db.Decimal(6, 2)
  finalMarks     Decimal @map("final_marks") @db.Decimal(6, 2)

  rubricScores  Json?   @map("rubric_scores")
  feedback      String? @db.Text
  /// BR-ASG-08 — NEVER visible to a student, in any response, export or report.
  internalNotes String? @map("internal_notes") @db.Text

  gradedBy   String    @map("graded_by") @db.Uuid
  gradedAt   DateTime  @default(now()) @map("graded_at")
  releasedAt DateTime? @map("released_at")

  /// BR-ASG-11 — changing a released grade requires a reason and is audited.
  revisionReason String? @map("revision_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("assignment_grades")
}

/// FR-ASG-024 / BR-ASG-13 — a per-student exception, visible on their record.
model AssignmentExtension {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  extendedTo   DateTime @map("extended_to")
  reason       String   @db.Text
  grantedBy    String   @map("granted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_extensions")
}

// =========================================================== quizzes (8.3.5)

