model QuestionBank {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(200)
  subjectId      String? @map("subject_id") @db.Uuid
  /// FR-QIZ-004 — a teacher owns their bank; null means the shared
  /// institute-wide bank.
  ownerTeacherId String? @map("owner_teacher_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  questions Question[]

  @@map("question_banks")
}

model Question {
  id             String       @id @default(uuid()) @db.Uuid
  questionBankId String       @map("question_bank_id") @db.Uuid
  subjectId      String?      @map("subject_id") @db.Uuid
  questionType   QuestionType @map("question_type")
  stem           String       @db.Text
  difficulty     Difficulty   @default(MEDIUM)
  defaultMarks   Decimal      @default(1) @map("default_marks") @db.Decimal(6, 2)
  /// FR-QIZ-006 — shown to the student only after results are released.
  explanation    String?      @db.Text

  /// SHORT_ANSWER, NUMERIC, FILL_BLANK. SEC-AUZ-009: never projected into a
  /// student-facing response during an attempt.
  acceptedAnswers Json?    @map("accepted_answers")
  /// NUMERIC — absolute tolerance.
  tolerance       Decimal? @db.Decimal(12, 4)
  caseSensitive   Boolean  @default(false) @map("case_sensitive")

  tags Json?

  /// FR-QIZ-009 — versioned on edit after use, so a past attempt continues to
  /// show what was actually asked.
  version   Int     @default(1) @db.SmallInt
  /// FR-QIZ-008 — a question used in a completed attempt is retired, never
  /// deleted.
  isRetired Boolean @default(false) @map("is_retired")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  bank    QuestionBank     @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  options QuestionOption[]
  answers QuizAnswer[]
  quizzes QuizQuestion[]

  @@index([questionBankId, isRetired])
  @@index([subjectId, questionType, difficulty])
  @@map("questions")
}

model QuestionOption {
  id           String  @id @default(uuid()) @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  optionText   String  @map("option_text") @db.Text
  /// SEC-AUZ-009 / BR-QIZ-07 — NEVER sent to a student mid-attempt, not even
  /// in a field the interface does not render.
  isCorrect    Boolean @default(false) @map("is_correct")
  /// MATCHING — the right-hand item this option pairs with.
  matchKey     String? @map("match_key") @db.VarChar(100)
  displayOrder Int     @map("display_order")
  feedback     String? @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, displayOrder])
  @@map("question_options")
}

model Quiz {
  id               String  @id @default(uuid()) @db.Uuid
  sectionSubjectId String  @map("section_subject_id") @db.Uuid
  lessonId         String? @map("lesson_id") @db.Uuid

  title        String  @db.VarChar(255)
  instructions String? @db.Text
  totalMarks   Decimal @map("total_marks") @db.Decimal(6, 2)

  opensAt          DateTime @map("opens_at")
  closesAt         DateTime @map("closes_at")
  /// FR-QIZ-013 — independent of the availability window.
  timeLimitMinutes Int?     @map("time_limit_minutes") @db.SmallInt

  maxAttempts    Int            @default(1) @map("max_attempts") @db.SmallInt
  attemptScoring AttemptScoring @default(HIGHEST) @map("attempt_scoring")

  shuffleQuestions Boolean @default(false) @map("shuffle_questions")
  shuffleOptions   Boolean @default(false) @map("shuffle_options")

  negativeMarking      NegativeMarking @default(NONE) @map("negative_marking")
  /// BR-QIZ-06 — applied to INCORRECT answers only, never to unanswered.
  negativeMarkingValue Decimal?        @map("negative_marking_value") @db.Decimal(6, 2)

  passingMarks Decimal? @map("passing_marks") @db.Decimal(6, 2)

  presentation            QuizPresentation @default(ONE_PER_PAGE)
  allowBackwardNavigation Boolean          @default(true) @map("allow_backward_navigation")

  resultReleasePolicy ResultReleasePolicy @default(AFTER_CLOSE) @map("result_release_policy")
  answerReviewPolicy  AnswerReviewPolicy  @default(AFTER_RELEASE) @map("answer_review_policy")

  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  resultsReleasedAt DateTime?         @map("results_released_at")

  /// FR-QIZ-014 — random draw rules, e.g. [{topic, difficulty, count}].
  selectionRules Json? @map("selection_rules")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([sectionSubjectId, publicationStatus])
  @@index([opensAt, closesAt])
  @@map("quizzes")
}

model QuizQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  quizId       String  @map("quiz_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  marks        Decimal @db.Decimal(6, 2)
  displayOrder Int     @map("display_order")

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([quizId, questionId])
  @@index([quizId, displayOrder])
  @@map("quiz_questions")
}

model QuizAttempt {
  id            String @id @default(uuid()) @db.Uuid
  quizId        String @map("quiz_id") @db.Uuid
  studentId     String @map("student_id") @db.Uuid
  attemptNumber Int    @map("attempt_number") @db.SmallInt

  /// BR-QIZ-04 — SERVER-authoritative. Remaining time is computed from this,
  /// never from a client clock and never from the time of reconnection.
  startedAt      DateTime  @default(now()) @map("started_at")
  expiresAt      DateTime? @map("expires_at")
  submittedAt    DateTime? @map("submitted_at")
  /// MANUAL | AUTO_TIME_EXPIRED
  submissionMode String?   @map("submission_mode") @db.VarChar(30)

  status AttemptStatus @default(IN_PROGRESS)

  /// BR-QIZ-02 — the order and selection ACTUALLY presented, so a dispute
  /// about what was asked is answerable.
  questionOrder Json @map("question_order")

  autoScore   Decimal?  @map("auto_score") @db.Decimal(6, 2)
  manualScore Decimal?  @map("manual_score") @db.Decimal(6, 2)
  finalScore  Decimal?  @map("final_score") @db.Decimal(6, 2)
  isPassed    Boolean?  @map("is_passed")
  releasedAt  DateTime? @map("released_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  /// DB-009 — the column existed with no constraint, so a deleted student left
  /// their attempts behind as orphans pointing at nothing.
  student Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers QuizAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, status])
  @@index([status])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id              String @id @default(uuid()) @db.Uuid
  attemptId       String @map("attempt_id") @db.Uuid
  questionId      String @map("question_id") @db.Uuid
  /// FR-QIZ-009 — pins WHICH version of the question was answered.
  questionVersion Int    @default(1) @map("question_version") @db.SmallInt

  /// Shape depends on the question type: selected option ids, text, a number,
  /// or a matching map.
  response Json?

  isCorrect        Boolean? @map("is_correct")
  marksAwarded     Decimal? @map("marks_awarded") @db.Decimal(6, 2)
  isManuallyGraded Boolean  @default(false) @map("is_manually_graded")
  gradedBy         String?  @map("graded_by") @db.Uuid
  graderComment    String?  @map("grader_comment") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_answers")
}

// ===========================================================================
//  COURSE MEDIA AND FEE STRUCTURES
// ===========================================================================

/// A picture the public is MEANT to see — a course thumbnail, and nothing else.
///
/// EVERY OTHER FILE IN THIS SYSTEM IS DELIBERATELY NOT PUBLIC. A payment slip,
/// a submission, a lecture recording: all of them are reached through an
/// authenticated request and a storage reference that never leaves the server
/// (SEC-FIL-009, ARC-041). A course thumbnail is the exact opposite — it is
/// shown to anonymous visitors on the landing page, and putting it behind the
/// same machinery would mean either a broken image for everybody who has not
/// signed in, or a hole punched in the rule that protects everything else.
///
/// So it is a SEPARATE MODEL rather than another DocumentType. The difference
/// between "readable by anyone with the link" and "readable only by the people
/// entitled to it" is the most consequential distinction in the file layer, and
/// it belongs in the schema rather than in an enum value whose significance
/// somebody has to remember.
///
/// `contentHash` is unique, so uploading the same picture twice reuses the row
/// instead of filling storage with copies of one logo.
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  /// COURSE_THUMBNAIL today. Named rather than assumed, so the next public
  /// image has somewhere to go that is not "reuse the thumbnail one".
  kind String @default("COURSE_THUMBNAIL") @db.VarChar(40)

  storageKey       String @map("storage_key") @db.VarChar(500)
  originalFilename String @map("original_filename") @db.VarChar(255)
  /// Determined by CONTENT, not by the extension (SEC-FIL-003).
  contentType String @map("content_type") @db.VarChar(100)
  sizeBytes   BigInt @map("size_bytes")
  contentHash String @unique @map("content_hash") @db.VarChar(64)

  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  programmes Programme[]
  subjects   Subject[]

  @@index([kind])
  @@map("media_assets")
}

/// What a course costs, in full, BEFORE anybody applies — FR-PAY-033.
///
/// THE GAP THIS FILLS. The application form asked for "the amount you paid"
/// and a bank slip, and the System had no idea what either should be: fees
/// existed only as FeeCharge rows raised against a student who was ALREADY
/// enrolled. An applicant was therefore asked to pay a number nobody had told
/// them, into an account nobody had named, and the office found out whether
/// they had got it right by reading the slip afterwards. The
/// AMOUNT_INSUFFICIENT rejection reason in the admission module exists because
/// of this.
///
/// ONE ACTIVE STRUCTURE PER PROGRAMME PER SESSION. `academicSessionId` null
/// means "this programme's standing fee", used by any session that has not
/// been given its own — so raising fees for one term does not require
/// re-entering them for every other programme.
///
/// AMOUNTS ARE NOT EDITED IN PLACE ONCE PUBLISHED. A published structure that
/// an applicant has already paid against is superseded by a new one rather
/// than rewritten, because the old numbers are what somebody was told and what
/// their slip will be checked against. `supersededAt` records that.
model FeeStructure {
  id          String  @id @default(uuid()) @db.Uuid
  programmeId String  @map("programme_id") @db.Uuid
  /// Null = the programme's standing structure, used by any session without
  /// one of its own.
  academicSessionId String? @map("academic_session_id") @db.Uuid

  name     String @db.VarChar(150)
  currency String @default("PKR") @db.Char(3)

  /// The whole cost of the course. The COMPONENT lines must add up to exactly
  /// this, and so must the INSTALMENT lines — checked before it can be
  /// published, because a fee table that does not add up is worse than none.
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)

  /// What the applicant pays NOW, to apply. Usually the first instalment.
  /// This is the number the application form checks the slip against.
  dueAtApplication Decimal @map("due_at_application") @db.Decimal(12, 2)

  /// Shown to the applicant under the table — refund policy, late fees, what
  /// the price includes. Free text because every institute's caveats differ.
  notes String? @db.Text

  /// DRAFT is invisible to applicants. PUBLISHED is what the apply page shows.
  /// The arithmetic is checked when it moves to PUBLISHED, not while it is
  /// being typed — a half-entered table is not an error, it is unfinished.
  status String @default("DRAFT") @db.VarChar(20)

  supersededAt DateTime? @map("superseded_at")

  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  programme       Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  lines           FeeStructureLine[]

  @@index([programmeId, status])
  @@index([academicSessionId])
  @@map("fee_structures")
}

/// One row of a fee table — either what the money is FOR, or WHEN it is due.
///
/// ONE TABLE FOR BOTH, distinguished by `kind`, because they are edited
/// together on one screen and validated by the same rule: each set must sum to
/// the structure's total. Two tables would mean two editors, two sort orders,
/// and two places to get the arithmetic check wrong.
model FeeStructureLine {
  id             String @id @default(uuid()) @db.Uuid
  feeStructureId String @map("fee_structure_id") @db.Uuid

  /// COMPONENT — "Tuition", "Registration", "Materials". What it is for.
  /// INSTALMENT — "First instalment". When it is due.
  kind String @db.VarChar(20)

  label  String  @db.VarChar(120)
  amount Decimal @db.Decimal(12, 2)

  /// INSTALMENT only: days after enrolment that this falls due. 0 is "on
  /// admission". Stored as an OFFSET rather than a date because one structure
  /// serves every applicant, and each of them enrols on a different day.
  dueAfterDays Int? @map("due_after_days")

  sortOrder Int @default(0) @map("sort_order")

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId, kind, sortOrder])
  @@map("fee_structure_lines")
}
