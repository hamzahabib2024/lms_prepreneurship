{
  "name": "lms",
  "version": "0.1.0",
  "private": true,
  "description": "Online Learning Management System — implementation of SRS-LMS-001 v2.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build -w @lms/shared && npm run build -w @lms/api",
    "dev": "npm run dev --workspace=@lms/api",
    "dev:web": "npm run dev --workspace=@lms/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@lms/api",
    "db:migrate": "npm run db:migrate --workspace=@lms/api",
    "db:seed": "npm run db:seed --workspace=@lms/api",
    "db:studio": "npm run db:studio --workspace=@lms/api",
    "keys:generate": "node scripts/generate-keys.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
