node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Compiler output must never land beside sources — a stale .d.ts in src/
# shadows the .ts it was generated from and produces baffling type errors.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map

# Secrets — SEC-CRY-008: secrets SHALL NOT be committed
.env
.env.*
!.env.example
keys/
*.pem
*.key

# Google service-account keys. The documented place for one is OUTSIDE this
# repository, but a file that has to live somewhere ends up next to the code
# often enough that this is worth having: a JSON key is not a password that can
# be changed if it leaks — the only remedy is deleting it in the Cloud Console
# and issuing another.
service-account*.json
*service-account.json
google-credentials*.json
credentials.json
gcp-*.json
client_secret*.json
# The folder Docker mounts the key from. Everything in it is a credential;
# only the note explaining that is kept.
/credentials/*
!/credentials/README.txt

# Local data
*.log
.DS_Store
Thumbs.db
pgdata/
# The pre-UTF8 cluster, kept until somebody is satisfied the conversion took.
# 73 MB of database files that must never reach a commit.
pgdata.*/
redisdata/
uploads/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Generated
apps/api/src/generated/

# Bytecode from the tooling scripts in scripts/ (brand audit, checklist,
# font fetch). Regenerated on every run and machine-specific.
__pycache__/
*.py[cod]

# Uploaded coursework and lecture files (local storage provider).
# Student work, never committed.
#
# Anchored with a leading slash on purpose: a bare `storage/` matches a
# directory of that name at ANY depth, which also swallows the storage
# ADAPTERS at apps/api/src/content/storage.
/storage/
/apps/api/storage/
backups/

# Word's lock files. They appear beside any .docx somebody has open and
# vanish when they close it, so they are never something to commit.
~$*

# A sample paper kept at the root to be fed to the upload forms while
# demonstrating the System. Once uploaded, the bytes live in the storage
# provider and are catalogued in the database, so this copy is a leftover of
# the upload rather than a source file.
#
# NAMED RATHER THAN MATCHED BY EXTENSION, on purpose. The project's own
# documents live at this root too — the Requirements Specification and the
# five guides are all tracked here — so a rule like /*.pdf or /*.docx would
# silently swallow the next one somebody adds. Ignoring a stray file is worth
# one line; ignoring a category that the repository legitimately uses is a
# trap set for whoever writes the next guide.
/Paper@GANs.pdf
